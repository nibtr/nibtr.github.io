---
import TOCSidebar from "@components/TOCSidebar.astro";
import Layout from "@layouts/Layout.astro"
import { getAllPostsAndSubposts, getAllProjects, getCombinedReadingTime, getParentId, getPostReadingTime, getSubpostCount, getTOCSections, hasSubposts, isSubpost } from "@lib/data-utils"
import { formatDate } from "@lib/utils";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects.map((project) => ({
    params: { id: project.id },
    props: project,
  }))
}

const project = Astro.props as unknown as CollectionEntry<"projects">;
const currentProjectId = Astro.params.id

const postReadingTime = await getPostReadingTime(currentProjectId)
const { Content, headings } = await render(project);
const tocSections = await getTOCSections(currentProjectId)
